# Copy to .env and fill in. .env is never committed (see .gitignore).
#
# Generate each shared token with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
#
# Both naming schemes work and one .env drives all four services. Partner A's
# FastAPI services (subject, csp) read the unprefixed names; Partner B's
# services (verifier, rp) prefer the LAB1_-prefixed name and fall back to the
# unprefixed one.

# --- shared by all four services -------------------------------------------

# Team name reported by every /health response.
TEAM=hayagreeva-jonathan

# Bind every interface. 127.0.0.1 works on the server and is invisible from
# campus, which is the second most common way to fail the conformance probe.
# On a dev machine, a concrete host here (e.g. 127.0.0.1 instead of 0.0.0.0)
# also becomes the host in the CSP's activation-email link and the RP's
# "authenticate_at" hint, so local runs don't point at team.json's production
# hostname. Set back to 0.0.0.0 when deploying for real - it must be 0.0.0.0
# there for campus reachability, and 0.0.0.0 is what falls through to
# team.json for those two URLs.
HOST=0.0.0.0

# Ports. Claimed on the Canvas discussion: 4100-4103.
# Subject +0, CSP +1, Verifier +2, RP +3.
SUBJECT_PORT=4100
CSP_PORT=4101
VERIFIER_PORT=4102
RP_PORT=4103
# Partner B's services accept the block as one setting instead, if you prefer:
# LAB1_PORT_BLOCK=4100

# --- Partner A's services ---------------------------------------------------

DB_PATH=app.db

# --- Partner B's services ---------------------------------------------------

# Shared tokens. Both are required; a service that cannot find its token
# refuses to start rather than falling back to a default.
# CSP -> Verifier, on POST /binding:
LAB1_CSP_BINDING_TOKEN=<paste 32 random characters here>
# RP -> Verifier, on POST /introspect:
LAB1_RP_INTROSPECT_TOKEN=<paste 32 random characters here>

# Assertion and session lifetimes, in seconds.
LAB1_ASSERTION_TTL_SECONDS=60
LAB1_SESSION_TTL_SECONDS=600

# Online-guessing limit on the Verifier: attempts per client address per window.
# Loose on purpose: every service runs on one host, so a tight limit locks out
# the probe and the Subject agent along with an attacker.
LAB1_AUTH_MAX_ATTEMPTS=10
LAB1_AUTH_WINDOW_SECONDS=60

# Refuse a session credential presented from an address it was not issued to.
LAB1_RP_PIN_SESSION_TO_CLIENT=1

# Quieten the per-request access log (used by the test suite).
LAB1_QUIET_LOG=0

# --- the React frontend (optional, never graded) -----------------------------

# The Vite dev server's port. It binds 127.0.0.1 only, so it is reached over an
# SSH tunnel and is invisible from campus either way.
#
# Deliberately OUTSIDE the lab's 4100-4199 range. We claimed 4100-4103 and all
# four are taken by the four services, so there is no spare inside our block;
# any other port in 4100-4199 belongs to the team that claimed that block, and
# section 4.4 of the lab says not to bind one we did not claim. Outside the
# range there is no claim to collide with.
#
# Set a different one per partner if you both run it on the shared server -
# loopback is not per-user, so otherwise the second one collides with the
# first and a tunnel reaches whichever won.
#
# Three things read this and they must agree: run_all.sh (which port to start
# on), vite.config.js (which port to bind), and the CSP (the "Log in" link on
# the activation page it serves). Changing it in one place used to leave the
# activation page pointing at a dead 5173.
FRONTEND_PORT=5173

# --- activation email (optional) --------------------------------------------

# The CSP mails the activation link for step 2. Leave these unset and it logs
# "Skipping activation email ... missing credentials" and carries on: the
# enrollment token comes back in the POST /apply response either way, the
# Subject agent drives step 2 through JSON, and the Sign up page offers the
# activation link directly. Nothing graded needs a working mail server.
#
# If you do set them, note two things. The lab server's own notes say "do not
# put anything sensitive on this server" - it is cleartext HTTP on purpose so
# traffic is readable in Wireshark - so use a throwaway account and an app
# password, never a real one. And .env is gitignored and must stay out of the
# submitted archive; section 9.1 makes a committed credential an automatic
# deduction.
#
# EMAIL_USERNAME=<a throwaway gmail address>
# EMAIL_PASSWORD=<a gmail app password, not the account password>
